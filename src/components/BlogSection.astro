---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<section class="section" id="blog">
  <div class="container">
    <p class="section-label reveal">Writing</p>
    <h2 class="section-title reveal reveal-delay-1">
      Recent blog posts
      <a href="/blog/">Full archive →</a>
    </h2>
    <p class="intro reveal reveal-delay-1">Things I have written recently.</p>
    <ul class="post-list">
      {posts.map((post, i) => (
        <li class={`reveal reveal-delay-${Math.min(i + 1, 3)}`}>
          <span class="date">{formatDate(post.data.pubDate)}</span>
          <span class="sep"> : </span>
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .intro {
    margin: -0.75rem 0 1.5rem;
    font-size: 0.875rem;
    color: var(--text-dim);
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li {
    margin-bottom: 0.65rem;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .date {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-dim);
  }

  .sep {
    color: var(--text-dim);
  }

  .post-list a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--border);
    transition:
      color 0.2s var(--ease-out),
      text-decoration-color 0.2s var(--ease-out);
  }

  .post-list a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
