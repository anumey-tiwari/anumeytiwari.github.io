---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="copyright">© {year} {site.name}</p>
    <div class="links">
      <a href={site.social.github} rel="noopener noreferrer" target="_blank">GitHub</a>
      <a href={site.social.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
      <a href={site.social.twitter} rel="noopener noreferrer" target="_blank">Twitter</a>
      <a href={`mailto:${site.email}`}>Email</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2.5rem 0;
    margin-top: 2rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .copyright {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-dim);
  }

  .links {
    display: flex;
    gap: 1.25rem;
  }

  .links a {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .links a:hover {
    color: var(--accent);
  }
</style>
